# --- Server ---
PORT=3000
PUBLIC_BASE_URL=https://your-deployed-domain.com

# Any long random string — used to sign vendor login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# One-time secret used to create the FIRST Super Admin account (see README
# "Super Admin setup"). Choose your own long random string; keep it private —
# anyone who knows it can create a Super Admin account once.
SUPER_ADMIN_SETUP_KEY=change_this_to_another_long_random_string

# --- WhatsApp (shared platform-level settings) ---
# This ONE verify token is shared across every vendor's Meta app. Each vendor,
# when registering their own webhook in their own Meta app, enters this SAME
# string as the "Verify Token" field. Individual vendor tokens/phone number
# IDs/app secrets are entered by each vendor from their own dashboard — NOT
# stored here. See README "Multi-tenant WhatsApp" section.
WHATSAPP_VERIFY_TOKEN=choose_a_random_secret_string

# --- TURN server (optional — improves call reliability at scale) ---
# Without this, calls use only a free public STUN server, which usually
# works but can fail for participants on restrictive corporate/mobile
# networks. Leave blank to skip; fill in once you have a TURN provider
# (e.g. a self-hosted Coturn server, or a managed provider) if you start
# seeing call-connection failures at higher daily volume.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# --- Gridlines KYC (platform-level — held only by the Super Admin / platform
# operator, never entered or visible to vendors) ---
GRIDLINES_API_KEY=your_gridlines_api_key
GRIDLINES_AUTH_TYPE=API-Key

# --- Gridlines KYC (platform-level — NOT shown to vendors) ---
# This key lives only here, in the server environment. Vendors and agents
# never see it or enter it — they just use the "Verify DL" / "Verify Aadhaar"
# buttons in a case, and the platform (you) absorbs the KYC provider cost.
GRIDLINES_API_KEY=your_gridlines_api_key
GRIDLINES_AUTH_TYPE=API-Key

# --- Storage (optional — see README "Media storage" section) ---
# Leave blank to store evidence files on local disk (fine for testing, but
# lost on redeploy on most hosts). Fill these in to store on S3-compatible
# storage (AWS S3, Cloudflare R2, Backblaze B2) instead.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=
